# Application
APP_NAME=enterprise-multi-agent-system
APP_ENV=development
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://replace.azurewebsites.net/api

# Webhook authentication - use distinct cryptographically random values
GITHUB_WEBHOOK_SECRET=replace-with-random-secret
GITHUB_WEBHOOK_PREVIOUS_SECRET=
INBOUND_WEBHOOK_SECRET=replace-with-different-random-secret
OPENAI_WEBHOOK_SECRET=replace-with-openai-dashboard-signing-secret
ANTHROPIC_WEBHOOK_SIGNING_KEY=replace-with-whsec-signing-key
ONEDRIVE_CLIENT_STATE=replace-with-random-client-state

# GitHub admission and spend guardrails. Numeric repository IDs are immutable.
GITHUB_ALLOWED_REPOSITORY_IDS=replace-with-numeric-repository-id
GITHUB_ALLOWED_EVENTS=push
GITHUB_TRUSTED_AUTHOR_ASSOCIATIONS=OWNER,MEMBER,COLLABORATOR
GITHUB_ALLOWED_APP_IDS=
GITHUB_DAILY_MODEL_LIMIT=100
GITHUB_QUOTA_TABLE_NAME=GitHubDailyModelQuota

# OneDrive for Business; subscription state is bootstrapped into Azure Table.
ONEDRIVE_DRIVE_ID=replace-with-drive-id
ONEDRIVE_TENANT_ID=replace-with-entra-tenant-id
ONEDRIVE_SUBSCRIPTION_TABLE_NAME=OneDriveSubscriptions

# AI routing: openai, claude, or both
AI_PROVIDER=openai
OPENAI_API_KEY=replace-with-api-key
OPENAI_MODEL=replace-with-approved-model-id
# Enable only for a dedicated OpenAI project owned by this gateway.
OPENAI_CALLBACK_RETRIEVAL=false
ANTHROPIC_API_KEY=replace-with-api-key
ANTHROPIC_MODEL=replace-with-approved-model-id

# Durable queues. Prefer the namespace with managed identity in Azure.
SERVICE_BUS_FULLY_QUALIFIED_NAMESPACE=replace.servicebus.windows.net
SERVICE_BUS_CONNECTION=
SERVICE_BUS_QUEUE_NAME=ai-events
SERVICE_BUS_RESULT_QUEUE_NAME=ai-results

# Production must use azure_table. SQLite is local-development only.
IDEMPOTENCY_BACKEND=sqlite
IDEMPOTENCY_SQLITE_PATH=.webhook-deliveries.db
RESULT_OUTBOX_SQLITE_PATH=.webhook-results.db
IDEMPOTENCY_STORAGE_CONNECTION=
IDEMPOTENCY_STORAGE_ACCOUNT_URL=
IDEMPOTENCY_TABLE_NAME=WebhookDeliveries
RESULT_OUTBOX_TABLE_NAME=WebhookResults
PAYLOAD_STORAGE_CONNECTION=
PAYLOAD_STORAGE_ACCOUNT_URL=
PAYLOAD_BLOB_CONTAINER=webhook-payloads

# Bounded HTTP and broker envelopes; Azure uses private Blob claim-checks.
MAX_WEBHOOK_BYTES=1048576
GITHUB_MAX_WEBHOOK_BYTES=26214400
MAX_QUEUE_MESSAGE_BYTES=192000

# Existing GitHub API client settings
GITHUB_TOKEN=replace-with-github-token
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_TIMEOUT=10.0
GITHUB_MAX_RETRIES=3
GITHUB_BACKOFF_FACTOR=0.5

# Existing outbound rate limiter settings
RATE_LIMIT_MAX_WORKERS=4
RATE_LIMIT_PER_HOST=1
RATE_LIMIT_BASE_BACKOFF_SECONDS=0.25
RATE_LIMIT_MAX_BACKOFF_SECONDS=30.0
RATE_LIMIT_JITTER_RATIO=0.25
